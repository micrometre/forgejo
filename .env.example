# -----------------------------------------------------------------------------
# Forgejo Configuration
# -----------------------------------------------------------------------------

# Forgejo image version tag (e.g. 16, latest, 16.0)
FORGEJO_VERSION=16

# Host port bindings
FORGEJO_HTTP_PORT=3000
FORGEJO_SSH_PORT=222

# UID and GID for internal 'git' user inside container
# Run `id -u` and `id -g` to check your host user IDs
USER_UID=1000
USER_GID=1000

# Domain and public root URL (used for web access and clone URLs)
FORGEJO_DOMAIN=localhost
FORGEJO_ROOT_URL=http://localhost:3000/

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_VERSION=16-alpine
POSTGRES_DB=forgejo
POSTGRES_USER=forgejo
POSTGRES_PASSWORD=forgejo

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
# Host directory for storing backups
BACKUP_DIR=/home/ubuntu/forgejo-backups

# rclone Google Drive remote and folder destination
RCLONE_REMOTE=gdrive:Forgejo-Backups
