# =============================================================================
# Forgejo Actions Runner Configuration
# Managed by Ansible - role: forgejo_runner
# =============================================================================

log:
  level: info
  job_level: info

runner:
  file: {{ forgejo_runner_dir }}/.runner
  capacity: {{ forgejo_runner_capacity }}
  timeout: 3h
  shutdown_timeout: 3h
  insecure: false
  fetch_timeout: 5s
  fetch_interval: 2s
  report_interval: 1s
  labels:
{% for label in forgejo_runner_labels %}
    - "{{ label }}"
{% endfor %}

cache:
  enabled: true
  dir: "{{ forgejo_runner_dir }}/.cache/actcache"
  host: ""
  port: 0

container:
  network: "bridge"
  enable_ipv6: false
  privileged: false
  options: "-v /var/run/docker.sock:/var/run/docker.sock"
  workdir_parent:
  valid_volumes:
    - "**"
  docker_host: "-"
  force_pull: false
  force_rebuild: false

host:
  workdir_parent: "{{ forgejo_runner_dir }}/.cache/act"
