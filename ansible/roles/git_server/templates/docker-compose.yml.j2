networks:
  forgejo:
    external: false

services:
  server:
    image: codeberg.org/forgejo/forgejo:{{ forgejo_version }}
    container_name: forgejo
    restart: always
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - FORGEJO__database__DB_TYPE=postgres
      - FORGEJO__database__HOST=db:5432
      - FORGEJO__database__NAME={{ postgres_db }}
      - FORGEJO__database__USER={{ postgres_user }}
      - FORGEJO__database__PASSWD={{ postgres_password }}
      - FORGEJO__server__DOMAIN={{ forgejo_domain }}
      - FORGEJO__server__SSH_DOMAIN={{ forgejo_domain }}
      - FORGEJO__server__ROOT_URL={{ forgejo_root_url }}
      - FORGEJO__server__SSH_PORT={{ forgejo_ssh_port }}
      - FORGEJO__server__SSH_LISTEN_PORT=22
      - FORGEJO__security__INSTALL_LOCK=true
      - FORGEJO__actions__ENABLED={{ forgejo_actions_enabled | default(true) | string | lower }}
      - FORGEJO__actions__DEFAULT_ACTIONS_URL={{ forgejo_actions_url | default('https://github.com') }}
    networks:
      - forgejo
    volumes:
      - ./data/forgejo:/data
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ forgejo_http_port }}:3000"
      - "{{ forgejo_ssh_port }}:22"
    depends_on:
      db:
        condition: service_healthy

  db:
    image: postgres:{{ postgres_version }}
    container_name: forgejo-db
    restart: always
    environment:
      - POSTGRES_USER={{ postgres_user }}
      - POSTGRES_PASSWORD={{ postgres_password }}
      - POSTGRES_DB={{ postgres_db }}
    networks:
      - forgejo
    volumes:
      - ./data/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user }} -d {{ postgres_db }}"]
      interval: 5s
      timeout: 5s
      retries: 5
